<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>EmbySubtitleOptimization</AssemblyName>
    <RootNamespace>EmbySubtitleOptimization</RootNamespace>
    <Description>Resolution-aware ASS and SRT subtitle optimizer for Emby Server.</Description>
    <PackageTags>emby;plugin;subtitle;ass;srt</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90" PrivateAssets="all" />
  </ItemGroup>
</Project>
